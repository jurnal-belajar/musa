# ── Telegram ──────────────────────────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram user ID yang boleh menggunakan bot (pisah koma, kosongkan = semua boleh)
# Cari user ID kamu dengan @userinfobot
ALLOWED_USER_IDS=123456789

# ── Identitas jurnal ──────────────────────────────────────────────────────────
# Nama anak pemilik jurnal ini (tampil di pesan bot)
BOT_NAME=Musa

# Path absolut ke root repo jurnal (folder yang berisi Activity-Log/)
# Contoh untuk Musa:    /home/user/musa
# Contoh untuk Aasiyah: /home/user/aasiyah
REPO_ROOT=/home/user/musa

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Daftar gratis di: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Whisper (transkripsi audio lokal, tanpa API key) ──────────────────────────
# Pilihan model: tiny | base | small | medium | large
# base = default (cepat, ~74MB), small = lebih akurat (~244MB)
WHISPER_MODEL=base
