# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (untuk transkripsi Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (untuk Claude AI formatter)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# (Opsional) Batasi akses hanya untuk user ID tertentu (pisahkan dengan koma)
# Kosongkan untuk mengizinkan semua user
# Cari Telegram user ID kamu dengan @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# Path ke root repo musa (default: satu folder di atas folder bot/)
# Biasanya tidak perlu diubah jika menjalankan bot dari folder bot/
REPO_ROOT=/path/to/musa

# Apakah otomatis commit & push ke git setelah menulis jurnal? (true/false)
AUTO_PUSH=true
